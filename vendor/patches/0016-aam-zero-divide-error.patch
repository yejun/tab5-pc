AAM with an immediate of 0 raises a divide error (#DE), as on x86 (it divided by 0: undefined in C; on x86 hosts
the emulator stopped with SIGFPE, on RISC-V it went on with whatever the division gave).

--- a/i386.c
+++ b/i386.c
@@ -3536,7 +3536,7 @@
 	cpu->cc.dst = sext8(res); \
 	cpu->cc.mask = ZF | SF | PF;
 }
-#define AAM(i, li, _) __AAM_helper(cpu, li(i));
+#define AAM(i, li, _) if (li(i) == 0) THROW0(EX_DE); __AAM_helper(cpu, li(i));
 
 #define SALC() \
 	if (get_CF(cpu)) sreg8(0, 0xff); else sreg8(0, 0x00);
