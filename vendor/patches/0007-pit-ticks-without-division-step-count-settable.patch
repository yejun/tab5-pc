 #include <stdio.h>
 #include "i8254.h"
+
+/* microseconds to PIT ticks: us * PIT_FREQ / 1000000, without a 64-bit division
+   (2562338834 = PIT_FREQ * 2^31 / 1000000, rounded down: at most a tick short) */
+static inline uint32_t pit_us_to_ticks(uint32_t us)
+{
+	return ((uint64_t) us * 2562338834u) >> 31;
+}
