i8254: microseconds to timer ticks with a multiply and a shift instead of a 64-bit division (a library call on a
32-bit host, three times per timer check); pc.c's PC_STEP_COUNT can be set by the includer.

diff --git a/i8254.c b/i8254.c
index 4444556..3c7297c 100644
--- a/i8254.c
+++ b/i8254.c
@@ -27,6 +27,13 @@
 
 #include <stdio.h>
 #include "i8254.h"
+
+/* microseconds to PIT ticks: us * PIT_FREQ / 1000000, without a 64-bit division
+   (2562338834 = PIT_FREQ * 2^31 / 1000000, rounded down: at most a tick short) */
+static inline uint32_t pit_us_to_ticks(uint32_t us)
+{
+	return ((uint64_t) us * 2562338834u) >> 31;
+}
 //#define DEBUG_PIT
 
 #define RW_STATE_LSB 1
@@ -76,7 +83,7 @@ static int pit_get_count(PITChannelState *s)
 
 	if (s->reload_pending)
 		return s->stopped_count;
-	d = ((uint64_t) (get_uticks() - s->count_load_time)) * PIT_FREQ / 1000000;
+	d = pit_us_to_ticks(get_uticks() - s->count_load_time);
 	switch(pit_mode(s)) {
 	case 0:
 	case 1:
@@ -103,7 +110,7 @@ static int pit_get_out1(PITChannelState *s, uint32_t current_time)
 
 	if (s->reload_pending)
 		return 0;
-	d = ((uint64_t) (current_time - s->count_load_time)) * PIT_FREQ / 1000000;
+	d = pit_us_to_ticks(current_time - s->count_load_time);
 	switch(pit_mode(s)) {
 	default:
 	case 0:
@@ -288,7 +295,7 @@ void i8254_update_irq(PITState *pit)
 {
 	uint32_t uticks = get_uticks();
 	PITChannelState *s = pit->channels;
-	uint32_t d = ((uint64_t) (uticks - s->count_load_time)) * PIT_FREQ / 1000000;
+	uint32_t d = pit_us_to_ticks(uticks - s->count_load_time);
 	switch(pit_mode(s)) {
 	case 2:
 	case 3:
