+/* Round m / 2^shift (shift >= 1) in the guest mode. At shift 64 the
+ * leading bit is the half unit; beyond it every nonzero input is below half. */
+static uint64_t fp_round_shift(uint64_t m, int shift, unsigned rc, bool negative)
+{
+	uint64_t kept = shift < 64 ? m >> shift : 0;
+	uint64_t lost = shift < 64 ? m - (kept << shift) : m;
+	bool increment = lost && rc == (negative ? 1u : 2u);
+	if (rc == 0 && shift <= 64) {
+		uint64_t half = UINT64_C(1) << (shift - 1);
+		increment = lost > half || (lost == half && (kept & 1));
+	}
+	return kept + increment;
+}
