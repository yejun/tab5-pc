+++ b/fpu.c
@@ -151,6 +151,10 @@
 	F80 rawst[8];
 	u8 rawtagr;
 	u8 rawtagw;
+#ifdef T386_FPU_SINGLES	/* registers a host's quick ways keep as singles: sb[i] exactly, st[i] maybe not */
+	u8 sv;
+	u32 sb[8];
+#endif
 
 #ifdef I386_ENABLE_SSE
 	u32 mxcsr;
@@ -190,6 +194,10 @@
