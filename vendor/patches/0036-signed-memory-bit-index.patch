Use a signed register index for memory BT, BTS, BTR and BTC.

--- a/i386.c
+++ b/i386.c
@@ -1263,6 +1263,14 @@
 #define Eb(...) E_helper(8, , __VA_ARGS__)
 #define Ev(...) if (opsz16) { E_helper(16, w, __VA_ARGS__) } else { E_helper(32, d, __VA_ARGS__) }
 
+/* Register indices into memory bit strings are signed. Align before dividing
+ * so that -1 addresses the previous word/dword, then wrap the effective offset. */
+static inline uword bit_string_addr(uword addr, sword index, int bits, bool adsz16)
+{
+	addr += (index & -bits) / 8;
+	return adsz16 ? (u16) addr : addr;
+}
