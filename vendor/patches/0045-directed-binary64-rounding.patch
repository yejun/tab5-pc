+/* Compare the exact product a*b with c (all positive, finite binary64).
+ * Normalize so the host multiply cannot overflow or underflow. */
+static int fp_product_cmp(double a, double b, double c)
+{
+	int ea, eb, ec;
+	double x = frexp(a, &ea), y = frexp(b, &eb), z = frexp(c, &ec);
+	int shift = ec - ea - eb;
+	/* x*y lies in [1/4, 1); z is in [1/2, 1). */
+	if (shift < -1) return 1;
+	if (shift > 0) return -1;
+	double target = shift ? z * 0.5 : z;
+	double product = x * y;
+	if (product != target)
+		return product > target ? 1 : -1;
+
+	/* The rounded product equals the target. In units of 2^-106 the
+	 * difference fits in 53 bits, so its low word gives its exact sign. */
+	uint64_t mx = (uint64_t) (x * 0x1p53), my = (uint64_t) (y * 0x1p53);
+	uint64_t mz = (uint64_t) (z * 0x1p53);
+	uint64_t diff = mx * my - (mz << (53 + shift));
+	return diff == 0 ? 0 : (diff >> 63) ? -1 : 1;
+}
+
+/* side is the sign of exact minus rounded. Step only when RC needs it. */
+static double fp_direct_neighbor(unsigned rc, double rounded, int side)
+{
+	if (side < 0 && (rc == 1 || (rc == 3 && rounded > 0)))
+		return nextafter(rounded, -INFINITY);
+	if (side > 0 && (rc == 2 || (rc == 3 && rounded < 0)))
+		return nextafter(rounded, INFINITY);
+	return rounded;
+}
+
+static __attribute__((noinline, cold)) double fp_direct53(FPU *fpu, int group, double a, double b, double c)
+{
+	unsigned rc = (fpu->cw >> 10) & 3;
+	if (!isfinite(a) || !isfinite(b) || (group == 6 && b == 0) || (group == 7 && a == 0))
+		return c;
+	if (isinf(c))  /* finite exact result exceeded the binary64 range */
+		return fp_direct_neighbor(rc, c, c > 0 ? -1 : 1);
+
+	int side;
+	if (group == 0 || group == 4 || group == 5) {
+		/* FastTwoSum recovers the exact residual with the larger addend first. */
+		if (group == 4) b = -b;
+		if (group == 5) a = -a;
+		if (c == 0 && rc == 1 && signbit(a) != signbit(b))
+			return -0.0;
+		double tail = fabs(a) >= fabs(b) ? b - (c - a) : a - (c - b);
+		side = (tail > 0) - (tail < 0);
+	} else {
+		if (a == 0 || b == 0) return c;
+		if (c == 0) side = 1;  /* nonzero magnitude rounded to zero */
+		else if (group == 1) side = fp_product_cmp(fabs(a), fabs(b), fabs(c));
+		else if (group == 6) side = -fp_product_cmp(fabs(c), fabs(b), fabs(a));
+		else side = -fp_product_cmp(fabs(c), fabs(a), fabs(b));
+		if (signbit(c)) side = -side;
+	}
+	return fp_direct_neighbor(rc, c, side);
+}
+
+static __attribute__((noinline)) double fp_root_direct53(FPU *fpu, double x, double root)
+{
+	if (!(x > 0) || !isfinite(x)) return root;
+	return fp_direct_neighbor((fpu->cw >> 10) & 3, root, -fp_product_cmp(root, root, x));
+}
