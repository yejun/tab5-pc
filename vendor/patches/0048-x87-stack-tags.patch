+static unsigned fptag(F80 v)
+{
+	unsigned exp = v.high & 0x7fff;
+	if (!exp && !(v.mant0 | v.mant1)) return 1;
+	return exp && exp != 0x7fff && (v.mant1 >> 31) ? 0 : 2;
+}
+
+static u16 fptags(FPU *fpu)
+{
+	u16 tags = 0;
+	for (int i = 0; i < 8; i++) {
+		unsigned tag = fpu->empty & (1 << i) ? 3 : fptag(fpvalue80(fpu, i));
+		tags |= tag << (2 * ((fpu->top + i) & 7));
+	}
+	return tags;
+}
