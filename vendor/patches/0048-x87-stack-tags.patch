+/* Only commit the stack fault and optional pop after the complete store succeeds. */
+static bool fpstore_empty(FPU *fpu, void *cpu, int op, int group, int seg, uword addr)
+{
+	bool ok;
+	if ((op == 3 && group == 7) || (op == 7 && group == 6)) /* m80 or packed BCD */
+		ok = cpu_store32(cpu, seg, addr, 0) && cpu_store32(cpu, seg, addr + 4, 0xc0000000) &&
+		     cpu_store16(cpu, seg, addr + 8, 0xffff);
+	else if (op == 1)
+		ok = cpu_store32(cpu, seg, addr, 0xffc00000);
+	else if (op == 3)
+		ok = cpu_store32(cpu, seg, addr, 0x80000000);
+	else if (op == 7 && group <= 3)
+		ok = cpu_store16(cpu, seg, addr, 0x8000);
+	else {
+		bool real = op == 5 && group != 1;
+		ok = cpu_store32(cpu, seg, addr, 0) &&
+		     cpu_store32(cpu, seg, addr + 4, real ? 0xfff80000 : 0x80000000);
+	}
+	if (!ok) return false;
+	fpstack_fault(fpu, false);
+	if (group != 2) fppop(fpu);
+	return true;
+}
