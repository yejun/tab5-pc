+
+static void fploadenv(FPU *fpu, const struct FPEnv *env)
+{
+	fpu->cw = env->cw;
+	setsw(fpu, env->sw);
+	fpu->empty = 0;
+	for (int i = 0; i < 8; i++)
+		if (((env->tags >> (2 * ((fpu->top + i) & 7))) & 3) == 3)
+			fpu->empty |= 1 << i;
