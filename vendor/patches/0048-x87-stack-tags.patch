+static bool fpreadenv(void *cpu, bool opsz16, int seg, uword addr, struct FPEnv *env)
+{
+	unsigned stride = opsz16 ? 2 : 4;
+	return cpu_load16(cpu, seg, addr, &env->cw) &&
+	       cpu_load16(cpu, seg, addr + stride, &env->sw) &&
+	       cpu_load16(cpu, seg, addr + 2 * stride, &env->tags);
