+/* FLD m80 and FLD ST(i) keep a value's exact 80 bits in rawst too, and FSTP m80 stores them while no instruction has
+ * written the register since: through a double an 80-bit value lost its low 11 bits of mantissa. */
+static void fppushraw(FPU *fpu, F80 v)
+{
+	fpu->top = (fpu->top - 1) & 7;
+	fpu->rawst[fpu->top] = v;
+	fpu->rawtagr &= ~(1 << fpu->top);
+	fpu->rawtagw &= ~(1 << fpu->top);
+#ifdef T386_FPU_SINGLES
+	fpu->sv &= ~(1 << fpu->top);
+#endif
+}
+
+static bool fpgetraw(FPU *fpu, int i, F80 *v)
+{
+	unsigned int idx = (fpu->top + i) & 7;
+	if (fpu->rawtagw & (1 << idx))
+		return false;
+	*v = fpu->rawst[idx];
+	return true;
+}
