+		/* (Tab5 386) From esp-hosted-mcu d7ebe00a: allocate the larger buffer before freeing the old one,
+		 * and on failure keep the old one and return NULL, so the caller drops this read (was: assert).
+		 * In PSRAM if there is room: whole cache lines, for reads of whole blocks (H_SDIO_RX_BLOCK_ONLY_XFER),
+		 * which the SDMMC driver takes there; it grows to the longest burst, and internal RAM runs short */
+		uint8_t *newbuf = (uint8_t *)heap_caps_aligned_alloc(128, len, MALLOC_CAP_SPIRAM);
+		if (!newbuf)
+			newbuf = (uint8_t *)g_h.funcs->_h_malloc_align(len, HOSTED_MEM_ALIGNMENT_64);
+		if (!newbuf) {
+			ESP_LOGW(TAG, "RX buffer alloc failed (len=%lu); dropping read", (unsigned long)len);
+			return NULL;
+		}
 		if (*buf) {
-			// free already allocated memory
+			// free the old (smaller) buffer now that the new one is secured
