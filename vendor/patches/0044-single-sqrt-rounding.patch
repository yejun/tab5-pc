+static double fpsqrt(FPU *fpu, double x)
+{
+	double root = fpnan(sqrt(x), x, 0);
+	if ((fpu->cw & 0x300) != 0 || sizeof(root) != 8)
+		return root;
+	union union64 r = { .f = root };
+	if ((r.i & 0xfffffff) == 0 && x > 0 && isfinite(x)) {
+		/* A 24-bit value or midpoint has at most 25 significand bits.
+		 * Its square is exact in binary64 after scaling to a safe exponent.
+		 * Recover the side of the boundary lost to the host sqrt. */
+		int e;
+		double m = frexp(root, &e);
+		double input = ldexp(x, -2 * e);
+		double square = m * m;
+		if (input > square)
+			r.i++;
+		else if (input < square)
+			r.i--;
+	}
+	return fpprec(fpu, r.f);
+}
