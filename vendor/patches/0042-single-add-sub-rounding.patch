+/* x is the host's nearest binary64 sum. At a 24-bit rounding boundary its
+ * discarded part matters: round-to-odd at binary64 before rounding to 24. */
+static double fpsum24(FPU *fpu, int group, double a, double b, double x)
+{
+	if (group == 4)
+		b = -b;  /* a - b */
+	if (group == 5)
+		a = -a;  /* b - a */
+
+	union union64 sum = { .f = x };
+	unsigned exp = (sum.i >> 52) & 0x7ff;
+	if (exp == 0x7ff)
+		return x;
+	if (x == 0) {
+		if (signbit(a) != signbit(b) && ((fpu->cw >> 10) & 3) == 1)
+			return -0.0;
+		return x;
+	}
+	/* A subnormal sum of binary64 operands is exact. Normalize before
+	 * limiting its significand to 24 bits, then undo the scaling. */
+	if (exp == 0)
+		return fpprec(fpu, x * 0x1p54) * 0x1p-54;
+	if ((sum.i & 0xfffffff) == 0) {  /* a 24-bit value or a midpoint */
+		/* FastTwoSum: subtract the larger addend first, exactly. */
+		double tail = fabs(a) >= fabs(b) ? b - (x - a) : a - (x - b);
+		if (tail != 0) {
+			if ((tail > 0) == (x > 0))
+				sum.i++;
+			else
+				sum.i--;
+		}
+	}
+	return fpprec(fpu, sum.f);
+}
