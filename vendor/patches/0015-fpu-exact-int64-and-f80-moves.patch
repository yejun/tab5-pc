+/* A register's exact 80 bits, kept in rawst while no instruction has written it (rawtagw's bit clear): FLD m80,
+ * FILD m64 and FLD ST(i) push them there, and FSTP m80, FISTP m64 store them, so that 64-bit integers and 80-bit
+ * values copied through the FPU (memory moves 8 bytes at a time do this) keep all their bits; a double has 53. */
+static void fppushraw(FPU *fpu, F80 v)
+{
+	fpu->top = (fpu->top - 1) & 7;
+	unsigned int mask = 1 << fpu->top;
+	fpu->rawst[fpu->top] = v;
+	fpu->rawtagr &= ~mask;
+	fpu->rawtagw &= ~mask;
+#ifdef T386_FPU_SINGLES
+	fpu->sv &= ~mask;
+#endif
+}
+
+static bool fpgetraw(FPU *fpu, int i, F80 *v)
+{
+	unsigned int idx = (fpu->top + i) & 7;
+	if (fpu->rawtagw & (1 << idx))
+		return false;
+	*v = fpu->rawst[idx];
+	return true;
+}
+
+static F80 i64tof80(int64_t v)
+{
+	F80 r = { 0, 0, 0 };
+	if (v == 0)
+		return r;
+	uint64_t m = v < 0 ? -(uint64_t) v : (uint64_t) v;
+	int lz = __builtin_clzll(m);
+	m <<= lz;
+	r.high = (v < 0 ? 0x8000 : 0) | (16383 + 63 - lz);
+	r.mant1 = m >> 32;
+	r.mant0 = m;
+	return r;
+}
+
+/* an integer exactly (no fraction, in range)? */
+static bool f80toi64(F80 f, int64_t *res)
+{
+	int exp = f.high & 0x7fff, neg = f.high >> 15;
+	uint64_t m = (uint64_t) f.mant1 << 32 | f.mant0;
+	if (m == 0 && exp == 0) {
+		*res = 0;
+		return true;
+	}
+	if (!(m >> 63) || exp < 16383 || exp > 16383 + 63)
+		return false;
+	int shift = 16383 + 63 - exp;
+	if (shift && (m << (64 - shift)))
+		return false;
+	uint64_t u = m >> shift;
+	if (u >> 63) {	/* only -2^63 fits */
+		if (!neg || u != (uint64_t) 1 << 63)
+			return false;
+		*res = (int64_t) u;
+		return true;
+	}
+	*res = neg ? -(int64_t) u : (int64_t) u;
+	return true;
+}
