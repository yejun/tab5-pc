+/* A host conversion can replace any NaN with its positive canonical NaN.
+ * Widen the guest sign and payload explicitly, quieting a signaling input. */
+static double fp32_to_double(u32 bits)
+{
+	union union32 single = { .i = bits };
+	if ((bits & 0x7fffffff) <= 0x7f800000)
+		return single.f;
+	union union64 wide = { .i = (uint64_t) (bits >> 31) << 63 | UINT64_C(0x7ff8000000000000) |
+		(uint64_t) (bits & 0x7fffff) << 29 };
+	return wide.f;
+}
