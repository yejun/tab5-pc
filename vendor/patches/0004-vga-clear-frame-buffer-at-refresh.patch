vga: a VBE mode set clears the frame buffer at the next refresh, from the refresh's thread, not from the CPU's
while a refresh running alongside (on another core) may be drawing into it. (Clearing when the picture changes
size is upstream's since 9eca597.)

diff --git a/vga.c b/vga.c
index 9a02b71..b091da6 100644
--- a/vga.c
+++ b/vga.c
@@ -723,7 +723,8 @@ static void vbe_update_vgaregs(VGAState *s)
     s->gr[VGA_GFX_MODE] = (s->gr[VGA_GFX_MODE] & ~0x60) |
         (shift_control << 5);
     s->cr[VGA_CRTC_MAX_SCAN] &= ~0x9f; /* no double scan */
-    simplefb_clear(s->fb_dev);
+    s->last_gw = -2;    /* the next refresh clears the frame buffer (not here: from the CPU's thread, while a
+                           refresh may be drawing into it) */
 }
 
 /* the text refresh is just for debugging and initial boot message, so
