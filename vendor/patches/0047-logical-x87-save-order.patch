+/* Keep the temporary register image off the ordinary arithmetic path. */
+static __attribute__((noinline)) bool fprestore(FPU *fpu, void *cpu, bool opsz16, int seg, uword addr)
+{
+	u16 cw, sw;
+	if (!cpu_load16(cpu, seg, addr, &cw) ||
+	    !cpu_load16(cpu, seg, addr + (opsz16 ? 2 : 4), &sw))
+		return false;
+	uword start = addr + (opsz16 ? 14 : 28);
+	F80 regs[8];
+	for (int j = 0; j < 8; j++, start += 10) {
+		if (!cpu_load32(cpu, seg, start, &regs[j].mant0) ||
+		    !cpu_load32(cpu, seg, start + 4, &regs[j].mant1) ||
+		    !cpu_load16(cpu, seg, start + 8, &regs[j].high))
+			return false;
+	}
+	/* The image starts with ST(0), relative to the restored TOP. */
+	fpu->cw = cw;
+	setsw(fpu, sw);
+	for (int j = 0; j < 8; j++)
+		fpsetraw(fpu, j, regs[j]);
+	return true;
+}
